rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================================================
    // 辅助函数 (Helper Functions)
    // ============================================================================
    
    /**
     * 检查用户是否已认证
     */
    function isAuthenticated() {
      return request.auth != null;
    }
    
    /**
     * 检查用户是否是文档所有者
     */
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    /**
     * ✨ 检查用户是否有特定角色（从 Custom Claims 读取）
     * ✅ 修复 2024-12-14: 支持 roles 数组格式
     */
    function hasRole(role) {
      return isAuthenticated() && 
             request.auth.token.roles != null &&
             request.auth.token.roles.hasAny([role]);
    }


    
    /**
     * ✨ 检查 Custom Claims 中的 organizationId 和 eventId 是否匹配
     * 🔥 临时宽松版本：只检查是否已认证
     */
    function isInContext(orgId, eventId) {
      // 嚴格版：claims 必須與路徑參數一致
      return isAuthenticated() &&
             request.auth.token.organizationId == orgId &&
             request.auth.token.eventId == eventId;
    }
    
    /**
     * ✅ 检查用户是否是 Event Manager（从 Custom Claims 读取）
     * 新架构：Event Manager 存储在 users 集合中，通过 roles=['eventManager'] 识别
     */
    function isEventManager(orgId, eventId) {
      return isInContext(orgId, eventId) && hasRole('eventManager');
    }
    
    /**
     * ✨ 检查用户是否是 Seller Manager（从 Custom Claims 读取）
     */
    function isSellerManager(orgId, eventId) {
      return isInContext(orgId, eventId) &&
           (hasRole('sellerManager') || hasRole('teamLeader'));
    }
    
    /**
     * ✨ 检查用户是否是 Merchant Manager（从 Custom Claims 读取）
     */
    function isMerchantManager(orgId, eventId) {
      return isInContext(orgId, eventId) && hasRole('merchantManager');
    }
    
    /**
     * ✨ 检查用户是否是 Cashier（从 Custom Claims 读取）
     */
    function isCashier(orgId, eventId) {
      return isInContext(orgId, eventId) && hasRole('cashier');
    }

    /**
     * ✨ 检查用户是否是 Auditor（从 Custom Claims 读取）
     * Auditor 是只读角色，可以查阅活动内所有数据但不能修改任何内容
     */
    function isAuditor(orgId, eventId) {
      return isInContext(orgId, eventId) && hasRole('auditor');
    }
    
    /**
     * ✨ 检查用户是否管理特定部门（从 Custom Claims 读取）
     */
    function managesDepartment(orgId, eventId, departmentCode) {
      return isAuthenticated() && 
             isInContext(orgId, eventId) &&
           (hasRole('sellerManager') || hasRole('teamLeader')) &&
             request.auth.token.managedDepartments != null &&
             departmentCode in request.auth.token.managedDepartments;
    }
    
    /**
     * 检查用户是否被特定 Seller Manager 管理
     */
    function isManagedBy(orgId, eventId, sellerId, managerId) {
      let seller = get(/databases/$(database)/documents/organizations/$(orgId)/events/$(eventId)/users/$(sellerId)).data;
        return seller.managedBy != null && seller.managedBy.hasAny([managerId]);
      }

      /**
       * 检查 Team Leader / Seller Manager 是否可管理该用户
       * 兼容旧的 managedBy 关系与新的 managedDepartments + department 模型
       */
      function canManageUser(orgId, eventId, userId) {
        let managedUser = get(/databases/$(database)/documents/organizations/$(orgId)/events/$(eventId)/users/$(userId)).data;
        return managedUser != null && (
                 isManagedBy(orgId, eventId, userId, request.auth.token.userId) ||
                 (managedUser.identityInfo != null &&
                  managedUser.identityInfo.department != null &&
                  managesDepartment(orgId, eventId, managedUser.identityInfo.department))
               );
    }
    
    /**
     * 检查是否只更新状态字段
     */
    function onlyStatusChange() {
      let affectedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return affectedKeys.hasOnly(['status', 'updatedAt', 'verifiedAt', 'verifiedBy']);
    }
    
    /**
     * 检查是否只更新允许的字段
     */
    function onlyAllowedFields(allowedFields) {
      let affectedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return affectedKeys.hasOnly(allowedFields);
    }
    
    // ============================================================================
    // Platform Admin (平台管理员)
    // ============================================================================
    function isPlatformAdmin() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/admin_uids/$(request.auth.uid));
    }

    match /admin_uids/{adminUid} {
      // Platform Admin 可以读取自己的信息
      allow read: if isOwner(adminUid);
      
      // 创建和修改需要超级管理员权限（通过 Cloud Functions）
      allow write: if false;
    }
    
    // ============================================================================
    // Organizations (组织/学校)
    // ============================================================================
    
    match /organizations/{organizationId} {
      // ✅ 允许所有人读取组织基本信息（用于登录页面显示）
      // 注意：organizations 只包含 orgCode, name 等非敏感信息
      allow read: if true;
      
      // ✅ Platform Admin 可以创建和修改组织
      allow create: if isPlatformAdmin();
      allow update: if isPlatformAdmin();
      allow delete: if isPlatformAdmin();
      
      // ============================================================================
      // Events (活动)
      // ============================================================================
      
      match /events/{eventId} {
        // ✅ 允许所有人读取活动基本信息（用于登录页面显示）
        // 注意：events 只包含 eventCode, name, dates 等非敏感信息
        allow read: if true;
        
        // ✅ Event Manager 可以更新活动信息（排除敏感字段）
        // 注意：不再检查 eventManager 对象，因为已迁移到 users 集合
        allow update: if isEventManager(organizationId, eventId) &&
                         !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                           'organizationId', 'orgCode', 'eventCode', 'createdBy', 'createdAt'
                         ]);
        
        // 创建只能通过 Cloud Functions
        allow create, delete: if false;
        
        // ========================================================================
        // Users (活动参与者，包括 Event Manager)
        // ========================================================================
        
        match /users/{userId} {
          /**
           * ✨ 读取规则（使用 Custom Claims）：
           * 1. 用户可以读取自己的数据
           * 2. Event Manager 可以读取所有用户
           * 3. 其他已认证用户可以读取（暂时放宽以支持销售流程）
           */
          allow read: if isAuthenticated() && (
                         request.auth.token.userId == userId ||
                         isEventManager(organizationId, eventId) ||
                         isAuditor(organizationId, eventId)
                       ) ||
                       isAuthenticated(); // 暂时放宽以支持销售流程
          
          /**
           * 创建规则：
           * 1. Event Manager 可以创建任何用户
           * 2. 通过 Cloud Functions 创建（注册流程）
           */
          allow create: if isEventManager(organizationId, eventId) ||
                           (isAuthenticated() && request.auth.token.userId == userId);
          
          /**
           * ✅ 更新规则：
           * 1. 用户可以更新自己的数据，但不能修改密码/PIN相关字段
           * 2. Event Manager 可以更新任何用户（但不能修改自己的 roles）
           * 3. Seller Manager 可以更新管理范围内用户的特定字段
           * 4. 禁止直接修改密码相关字段（passwordHash, passwordSalt, transactionPinHash, transactionPinSalt）
           */
          allow update: if (isAuthenticated() && request.auth.token.userId == userId && 
                           onlyAllowedFields(['basicInfo', 'updatedAt']) &&
                           !request.resource.data.basicInfo.diff(resource.data.basicInfo)
                             .affectedKeys().hasAny(['passwordHash', 'passwordSalt', 'transactionPinHash', 'transactionPinSalt', 'pinHash', 'pinSalt'])) ||
                           // 允许 Team Leader / Seller Manager 更新自己的现金统计（收款/上交等）
                           (isSellerManager(organizationId, eventId) &&
                            request.auth.token.userId == userId &&
                            onlyAllowedFields(['teamLeader', 'pointsStats', 'updatedAt'])) ||
                           (isEventManager(organizationId, eventId) &&
                            // Event Manager 不能修改自己的 roles
                            !(request.auth.token.userId == userId && 
                              request.resource.data.diff(resource.data).affectedKeys().hasAny(['roles']))) ||
                           (isSellerManager(organizationId, eventId) && 
                            canManageUser(organizationId, eventId, userId) &&
                            onlyAllowedFields(['customer', 'seller', 'cashAccount', 'pointsStats', 'updatedAt'])) ||
                           (isAuthenticated() && 
                            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seller', 'updatedAt'])) ||
                           (isAuthenticated() && 
                            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['merchant', 'updatedAt'])) ||
                           (isAuthenticated() && 
                            request.auth.token.userId == userId &&
                            onlyAllowedFields(['customer', 'seller', 'pointsStats', 'updatedAt', 'activityData', 'merchantAsist', 'merchantOwner']));
          
          /**
           * ✅ 删除规则：只能通过 Cloud Functions 或 Event Manager
           */
          allow delete: if isEventManager(organizationId, eventId);

          // ====================================================================
          // Point Allocations (点数分配记录 - Users 子集合)
          // ====================================================================

          match /pointAllocations/{allocationId} {
            /**
             * ✅ 读取规则：
             * 1. Seller Manager 可以读取自己的分配记录
             * 2. Event Manager 可以读取所有用户的分配记录
             * 3. Auditor 可以读取（审计用途）
             */
            allow read: if isAuthenticated() && (
                           request.auth.token.userId == userId ||
                           isEventManager(organizationId, eventId) ||
                           isAuditor(organizationId, eventId)
                         );

            /**
             * 写入规则：只能通过 Cloud Functions
             */
            allow write: if false;
          }
        }

        // ========================================================================
        // Cash Collections (SellerManager 已确认收款记录)
        // ========================================================================

        match /cashCollections/{collectionId} {
          /**
           * ✅ 读取规则
           * 1. 收款者（SellerManager）可以读取自己的记录
           * 2. 原提交者（sellerId）可以读取自己的记录
           * 3. Cashier / Event Manager 可以读取全部记录
           * 4. Seller Manager 可读取（用于上交页聚合与筛选）
           */
          allow read: if isAuthenticated() &&
                         (resource.data.collectedBy == request.auth.token.userId ||
                          resource.data.sellerId == request.auth.token.userId ||
                          isCashier(organizationId, eventId) ||
                          isEventManager(organizationId, eventId) ||
                          isAuditor(organizationId, eventId) ||
                          isSellerManager(organizationId, eventId));

          // Team Leader / Seller Manager 可创建收款记录；修改与删除仍仅允许后端处理
          allow create: if isSellerManager(organizationId, eventId);
          allow update, delete: if false;
        }
        
        // ========================================================================
        // Cash Handover Records (现金上交记录 - Event 级别集合)
        // ========================================================================
        
        match /cashHandovers/{handoverId} {
          /**
           * ✅ 读取规则（修复版）
           * 1. 提交者可以读取自己的记录
           * 2. Cashier 可以读取所有记录
           * 3. Event Manager 可以读取所有记录
           * 4. 接收者（receivedBy）可以读取相关记录（用于确认收到现金的SM/Cashier/FinanceManager）
           */
          allow read: if isAuthenticated() &&
                         (resource.data.submittedBy == request.auth.token.userId ||
                          isCashier(organizationId, eventId) ||
                          isEventManager(organizationId, eventId) ||
                          isAuditor(organizationId, eventId)) ||
                         (isAuthenticated() && resource.data.submittedBy == request.auth.token.userId) ||
                         (isSellerManager(organizationId, eventId) && 
                          resource.data.receivedBy == request.auth.token.userId);
          
          /**
           * ✅ 创建规则（修复版）
           * 1. Seller 可以创建上交记录（给 Seller Manager 或待认领池子）
           * 2. Seller Manager 可以创建上交记录（给 Finance Manager）
           * 3. Point Seller 可以创建上交记录（给 Finance Manager）
           * 4. 必须包含必填字段
           * 5. 状态必须是 pending
           * 6. organizationId 和 eventId 必须匹配
           */
          allow create: if isAuthenticated() &&
                           request.resource.data.keys().hasAll([
                             'submittedBy', 'submitterRole', 'amount',
                             'status', 'eventId', 'organizationId'
                           ]) &&
                           request.resource.data.submittedBy == request.auth.token.userId &&
                           request.resource.data.amount > 0 &&
                           request.resource.data.status == 'pending' &&
                           request.resource.data.organizationId == organizationId &&
                           request.resource.data.eventId == eventId &&
                           (hasRole('seller') || hasRole('sellerManager') || hasRole('pointSeller'));
          
          /**
           * ✅ 更新规则（修复版）
           * 1. Seller Manager 可以取消自己提交的待审核记录
           * 2. Cashier 可以更新状态（确认/拒绝/争议）
           * 3. 只能修改特定字段
           */
          allow update: if (isSellerManager(organizationId, eventId) &&
                           resource.data.submittedBy == request.auth.token.userId &&
                           resource.data.status == 'pending' &&
                           request.resource.data.status == 'cancelled' &&
                           onlyAllowedFields(['status', 'updatedAt'])) ||
                           (isCashier(organizationId, eventId) &&
                           onlyAllowedFields(['status', 'verifiedAt', 'verifiedBy', 'verifiedAmount', 'discrepancy', 'discrepancyReason', 'notes', 'updatedAt', 'confirmationNote', 'receivedBy', 'receiverName']));
          
          /**
           * ✅ 删除规则：只能通过 Cloud Functions 或 Event Manager
           */
          allow delete: if isEventManager(organizationId, eventId);
        }
        
        // ========================================================================
        // Cash Submissions (现金上交记录 - 待认领池子模式 - Event 级别集合)
        // ⭐ 新增：2026-01-22
        // ========================================================================
        
        match /cashSubmissions/{submissionId} {
          /**
           * ✅ 读取规则
           * 1. 提交者可以读取自己的记录
           * 2. Cashier 可以读取所有记录（用于待认领池子和历史查询）
           * 3. Event Manager 可以读取所有记录
           * 4. 已接单的 FM（receivedBy）可以读取该记录
           */
          allow read: if isAuthenticated() &&
                         (resource.data.submittedBy == request.auth.token.userId ||
                          isCashier(organizationId, eventId) ||
                          isEventManager(organizationId, eventId) ||
                          isAuditor(organizationId, eventId) ||
                          (resource.data.receivedBy != null && resource.data.receivedBy == request.auth.token.userId));
          
          /**
           * ✅ 创建规则
           * 1. Seller / Seller Manager / Point Seller 可以创建上交记录
           * 2. 必须包含必填字段
           * 3. 状态必须是 'pending'
           * 4. receivedBy 初始必须是 null（待认领池子）
           * 5. 提交者必须是当前登录用户
           */
          allow create: if isAuthenticated() &&
                           request.resource.data.keys().hasAll([
                             'submittedBy', 'submitterRole', 'submitterName', 'amount',
                             'status', 'eventId', 'organizationId', 'submittedAt'
                           ]) &&
                           request.resource.data.submittedBy == request.auth.token.userId &&
                           request.resource.data.amount > 0 &&
                           request.resource.data.status == 'pending' &&
                           request.resource.data.receivedBy == null &&
                           request.resource.data.organizationId == organizationId &&
                           request.resource.data.eventId == eventId &&
                           (hasRole('seller') || hasRole('sellerManager') || hasRole('pointSeller'));
          
          /**
           * ✅ 更新规则
           * 1. Cashier 可以接单：更新 receivedBy / status / confirmedAt 等
           * 2. Event Manager 可以更新任何字段用于管理
           * 3. 提交者只能在待认领时取消（status: cancelled）
           * 4. 更新必须是限制字段，防止篡改
           */
          allow update: if isCashier(organizationId, eventId) &&
                           onlyAllowedFields(['status', 'receivedBy', 'receiverName', 'confirmedAt', 'note', 'updatedAt']) ||
                           isEventManager(organizationId, eventId) ||
                           (isAuthenticated() &&
                            request.auth.token.userId == resource.data.submittedBy &&
                            resource.data.status == 'pending' &&
                            request.resource.data.status == 'cancelled' &&
                            onlyAllowedFields(['status', 'updatedAt']));
          
          /**
           * ✅ 删除规则
           * 只能通过 Cloud Functions 或 Event Manager
           */
          allow delete: if isEventManager(organizationId, eventId);
        }

        // ========================================================================
        // Customers (客户资料与点数账户)
        // ========================================================================

        match /customers/{customerId} {
          /**
           * 读取规则：
           * 1. 客户本人可以读取自己的记录
           * 2. Event Manager 可以读取所有客户记录
           * 3. Merchant Owner / Merchant Asist 可以读取，用于 RFID 支付查找客户
           * 4. Cashier / Auditor 也可读取，用于收款与审计
           */
          allow read: if isAuthenticated() && (
                         request.auth.token.userId == customerId ||
                         isEventManager(organizationId, eventId) ||
                         isCashier(organizationId, eventId) ||
                         isAuditor(organizationId, eventId) ||
                         (isInContext(organizationId, eventId) && (hasRole('merchantOwner') || hasRole('merchantAsist')))
                       );

          /**
           * 写入规则：仅 Cloud Functions 或 Event Manager
           */
          allow create, update, delete: if isEventManager(organizationId, eventId);
        }
        
        // ========================================================================
        // Department Stats (部门统计 - Event 级别集合)
        // ========================================================================
        
        match /departmentStats/{departmentCode} {
          /**
           * 读取规则：
           * 1. Event Manager 可以读取所有部门统计
           * 2. Seller Manager 可以读取管理的部门统计
           * 3. Cashier 可以读取所有部门统计
           */
          allow read: if isEventManager(organizationId, eventId) ||
                         isCashier(organizationId, eventId) ||
                         isAuditor(organizationId, eventId) ||
                         (isSellerManager(organizationId, eventId) &&
                          managesDepartment(organizationId, eventId, departmentCode));
          
          /**
           * 写入规则：只能通过 Cloud Functions（自动维护统计）
           */
          allow write: if false;
        }
        
        // ========================================================================
        // Team Leader Stats (TeamLeader/SM 统计 - Event 级别集合)
        // ========================================================================
        
        match /teamLeaderStats/{teamLeaderId} {
          /**
           * 读取规则：
           * 1. Team Leader / Seller Manager 可以读取自己的统计
           * 2. Event Manager 可以读取所有统计
           * 3. Cashier 可以读取所有统计
           * 4. Auditor 可以读取所有统计（审计用途）
           */
          allow read: if (isAuthenticated() && request.auth.token.userId == teamLeaderId) ||
                         isEventManager(organizationId, eventId) ||
                         isCashier(organizationId, eventId) ||
                         isAuditor(organizationId, eventId);
          
          /**
           * 写入规则：只能通过 Cloud Functions（自动维护统计）
           */
          allow write: if false;
        }
        
        // ========================================================================
        // Cashier Stats (Cashier 统计 - Event 级别集合)
        // ========================================================================
        
        match /cashierStats/{cashierId} {
          /**
           * 读取规则：
           * 1. Cashier 可以读取自己的统计
           * 2. Event Manager 可以读取所有 Cashier 统计
           */
          allow read: if (isAuthenticated() && request.auth.token.userId == cashierId) ||
                         isEventManager(organizationId, eventId) ||
                         isAuditor(organizationId, eventId);
          
          /**
           * 写入规则：只能通过 Cloud Functions（自动维护统计）
           */
          allow write: if false;
        }
        
        // ========================================================================
        // Transactions (交易记录 - Event 级别集合)
        // ========================================================================
        
        match /transactions/{transactionId} {
          /**
           * 🔥 临时宽松读取规则：允许所有已认证用户读取
           * 用于测试和调试
           */
          allow read: if isAuthenticated();
          
          /**
           * 创建规则：
           * 🔥 临时宽松版本：允许所有已认证用户创建
           */
          // 收緊：需已認證、且交易文件的 org/event 與路徑一致
          allow create: if isAuthenticated() &&
                           request.resource.data.organizationId == organizationId &&
                           request.resource.data.eventId == eventId;
          
          /**
           * 更新和删除：只能通过 Cloud Functions
           */
          allow update, delete: if false;
        }
        
        // ========================================================================
        // ⭐ Merchants (商家摊位 - Event 级别集合)
        // ⭐ 新增：2026-01-17 修复 merchantOwner 无法查询摊位的问题
        // ========================================================================
        
        match /merchants/{merchantId} {
          /**
           * 读取规则：
           * 1. merchantOwner 可以查询和读取（用于 getMerchantByUserId）
           * 2. merchantAsist 可以查询和读取
           * 3. merchantManager 可以读取所有摊位
           * 4. eventManager 可以读取所有摊位
           * 5. customer 可以读取营业中的摊位
           * 6. platformAdmin 可以读取QR Code
           */
          allow read: if isAuthenticated() && (
            isPlatformAdmin() ||
            hasRole('merchantOwner') ||
            hasRole('merchantAsist') ||
            isMerchantManager(organizationId, eventId) ||
            isEventManager(organizationId, eventId) ||
            isAuditor(organizationId, eventId) ||
            (hasRole('customer') && resource.data.operationStatus.isActive == true)
          );
          
          /**
           * 写入规则：只能通过 Cloud Functions
           */
          allow write: if false;
        }
        
        // ========================================================================
        // Point Cards (点数卡 - Event 级别集合)
        // ⭐ 修正日期：2025-01-20
        // ⭐ 核心原则：所有写入操作必须通过 Cloud Functions
        // ========================================================================
        
        match /pointCards/{cardId} {
          /**
           * ✅ 创建规则：
           * 只能通过 Cloud Functions 创建
           * 禁止前端直接创建，防止伪造点数卡
           */
          allow create: if false;
          
          /**
           * ✅ 读取规则：
           * 1. 任何认证用户可以读取（用于查询余额）
           *    - Merchant 扫码后查询点数卡余额
           *    - Customer 查询自己的点数卡余额
           * 2. PointSeller 可以读取自己发行的点数卡
           * 3. Event Manager 可以读取所有点数卡
           * 4. Cashier 可以读取所有点数卡（用于财务审计）
           * 
           * 注意：读取不会泄露敏感信息，点数卡是不记名的
           */
          allow read: if isAuthenticated() && isInContext(organizationId, eventId);
          
          /**
           * ✅ 更新规则：
           * 只能通过 Cloud Functions 更新
           * 禁止前端直接修改余额，防止恶意篡改
           * 
           * 所有余额变动必须经过后端验证：
           * - processPointCardPayment (Merchant 扣款)
           * - topupFromPointCard (Customer 充值)
           */
          allow update: if false;
          
          /**
           * ✅ 删除规则：
           * 只能通过 Cloud Functions 或 Event Manager
           */
          allow delete: if isEventManager(organizationId, eventId);
        }
      }
    }
    
    // ============================================================================
    // 默认规则：拒绝所有其他访问
    // ============================================================================
    
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
