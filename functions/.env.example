# Cloud Functions dotenv 配置
# 2026-03 起已改用 dotenv，請勿再使用 functions.config()

# OTP 開發模式
USE_DEV_OTP=false
DEV_OTP_CODE=223344

# SMS 提供商選擇
# 設定為 '360'；留空時會自動偵測配置
SMS_PROVIDER=360

# 360 SMS 非機密配置
# 實際發送採用下列端點
API_BASE_URL_360=https://sms.360.my/gw/bulk360/v3_0/send.php

# SMS 機密已改用 Secret Manager：
# firebase functions:secrets:set SMS_SECRETS --data-file functions/SMS_SECRETS.example.json
