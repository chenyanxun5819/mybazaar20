# OTP Forwarder 環境變量配置

# 伺服器設定
PORT=3000

# 360 SMS API 認證
# 從 Firebase Secret Manager 或環境變量取得
API_KEY_360=your_api_key_here
API_SECRET_360=your_api_secret_here

# 360 SMS API 端點
API_BASE_URL_360=https://sms.360.my/gw/bulk360/v3_0/send.php

# 安全設定：允許的來源 IP（逗號分隔）
# 包括：
# - 127.0.0.1: 本地測試
# - 10.128.0.0/10: GCP 內部網路
# - 34.123.222.228: 此 VM 的外部 IP（自己呼叫自己用）
ALLOWED_SOURCES=127.0.0.1,::1,10.128.0.0/10,34.123.222.228

# 日誌等級（可選）
LOG_LEVEL=info
